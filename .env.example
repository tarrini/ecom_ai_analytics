# Kaggle
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
KAGGLE_DATASET=olistbr/brazilian-ecommerce

# GCP
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET=your_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=C:\full\path\to\service-account.json
GCP_REGION=us-central1
VERTEX_PIPELINE_ROOT=gs://your_bucket/vertex/pipeline-root
# Required for forecast/delay Model.upload (staging local artifacts). Defaults to bucket from VERTEX_PIPELINE_ROOT if unset.
VERTEX_AI_GCS_STAGING_BUCKET=gs://your_bucket
# SA whose credentials Vertex pipeline pods use (not optional — omitting submit falls back to *-compute@developer.gserviceaccount.com and usually fails IAM).
VERTEX_SERVICE_ACCOUNT=your-runner-sa@your_project_id.iam.gserviceaccount.com

# Snowflake
SNOWFLAKE_ACCOUNT=xxxxx
SNOWFLAKE_USER=xxxxx
SNOWFLAKE_PASSWORD=xxxxx
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ECOM_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Optional
GCS_PREFIX=bronze/olist

TABLEAU_SERVER_URL=https://your-tableau-server-or-cloud-url
TABLEAU_SITE_NAME=your_site_name_or_content_url
TABLEAU_PAT_NAME=your_pat_name
TABLEAU_PAT_SECRET=your_pat_secret
TABLEAU_DATASOURCE_ID=optional_datasource_id
TABLEAU_WORKBOOK_ID=optional_workbook_id
TABLEAU_API_VERSION=3.22
RUN_TABLEAU_REFRESH=true

# Vertex AI automation controls
# Wait for pipeline terminal state before exiting (so e.g. Tableau runs after Vertex finishes).
VERTEX_PIPELINE_WAIT_FOR_COMPLETION=true
RUN_VERTEX_PIPELINE=false
RUN_ML_TRAINING=true
RUN_LLM_BRIEF=true
VERTEX_PIPELINE_TEMPLATE_PATH=gs://your_bucket/vertex/templates/ecom_vertex_pipeline.json
VERTEX_PIPELINE_DISPLAY_NAME_PREFIX=ecom-analytics
# Full template root params can be omitted here — run_vertex_ai_pipeline_job.py fills from GCP_* / SNOWFLAKE_* / OPENAI_* env vars when unset.
# Override any key by setting JSON, e.g. {"openai_model": "gpt-4o"}.
VERTEX_PIPELINE_PARAMS_JSON={}

OPENAI_API_KEY=your_key
OPENAI_MODEL=gpt-4o-mini
